{
    "name": "Blazma Get Browser Helper",
    "action": {
        "default_popup": "popup.html",
        "default_title": "Blazma Get"
    },
    "manifest_version": 3,
    "version": "3.4",
    "description": "Download files and videos with Blazma Get.",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "cookies",
        "webRequest",
        "tabs",
        "storage",
        "contextMenus",
        "alarms"
    ],
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}